# Configuración de entorno para stockflow-pos
# Copia este archivo a .env y define una SECRET_KEY aleatoria en producción.

APP_NAME=StockFlow POS
APP_ENV=development
SEED_DEMO_DATA=true
DATABASE_URL=sqlite:///./stockflow.db
# En desarrollo, si se omite SECRET_KEY se genera una clave aleatoria por proceso.
# En producción define una clave fija de mínimo 32 caracteres:
# SECRET_KEY=genera-una-clave-con-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=480
IGV_RATE=0.18
EXPIRY_ALERT_DAYS=30
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
